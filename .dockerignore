# Keep the Docker build context small and free of local state/secrets.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Secrets and local config
.env
*.pem

# Local databases, checkpoints, and indexes (rebuilt in the container)
*.db
*.db-wal
*.db-shm
data/checkpoints
data/chroma

# Frontend build artefacts (web/ has its own Dockerfile)
**/node_modules
web/dist

# Editor / OS noise
.vscode
.idea
.claude
*.swp
.DS_Store
Thumbs.db

# Docs media not needed at runtime
docs/demo.gif
