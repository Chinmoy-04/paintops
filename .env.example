# PaintOps configuration — copy to .env and adjust as needed.
# SYNTHETIC DEMO ONLY — not for production industrial decisions.

# Application
DEMO_MODE=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Databases (separate files for business data vs LangGraph checkpoints)
DATABASE_URL=sqlite:///./data/paintops.db
CHECKPOINT_DB_PATH=./data/checkpoints/langgraph.db

# Routing policy (synthetic demo thresholds — NOT real paint-shop limits)
RECURRENCE_WINDOW_MINUTES=60
RECURRENCE_ACTION_THRESHOLD=3
HIGH_SEVERITY_ACTION_REQUIRED=true

# LLM provider abstraction (not required when DEMO_MODE=true)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TEMPERATURE=0
# Alternative hosted provider (optional; leave blank for demo mode)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# RAG
SOP_DIR=./data/sops
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SOP_TOP_K=3

# Streamlit → API
PAINTOPS_API_BASE=http://localhost:8000

# API security
# Shared secret required in the X-PaintOps-Key header on POST /api/events and
# POST /api/scenarios/{name} (ingest and n8n-facing routes). Change it.
PAINTOPS_API_KEY=paintops-dev-key
# Browser origins allowed by CORS (JSON list). The Phase 3 web UI runs on Vite's port.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
